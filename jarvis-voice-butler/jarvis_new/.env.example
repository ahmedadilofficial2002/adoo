# LiveKit Cloud project keys — create a free project at https://cloud.livekit.io
# and copy the values from your Project Settings page.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=<your_livekit_api_key>
LIVEKIT_API_SECRET=<your_livekit_api_secret>

# Google AI Studio / Gemini API key — get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=<your_google_ai_api_key>

# Optional: Gmail / email credentials for agent email tools
# Do NOT put real secrets here. Copy this file to .env.local and fill values there.
GMAIL_USER=
GMAIL_PASSWORD=
