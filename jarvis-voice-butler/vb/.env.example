# Copy to .env and fill values. Never commit secrets.

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
VB_AI_MODEL=llama3.2

# SIM808 serial (Windows COM3, Linux /dev/ttyUSB0 or /dev/serial0)
SIM808_PORT=COM3
SIM808_BAUDRATE=115200

# Email (IMAP/SMTP). Password via env only.
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_SMTP_HOST=
EMAIL_FROM=

# Optional weather override; Open-Meteo needs no key.
# OPENWEATHER_API_KEY=

# Optional OpenAI-compatible local/cloud endpoint
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
